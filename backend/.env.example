# Salin menjadi .env lalu sesuaikan. Jangan commit file .env.
PORT=8000

# Alamat publik backend, dipakai untuk URL gambar absolut. Saat deploy ganti ke domain asli (https).
PUBLIC_URL=http://localhost:8000

# Origin frontend yang boleh memanggil API (pisahkan dengan koma). Tambahkan domain produksi nanti.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Akun admin untuk halaman /admin di frontend. Kata sandi minimal 8 karakter.
# Kosong = login admin nonaktif.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opsional: token rahasia untuk skrip/otomasi (header Authorization: Bearer ...), minimal 24 karakter.
ADMIN_TOKEN=

# Isi 1 HANYA bila backend di belakang Nginx/Caddy/Cloudflare.
TRUST_PROXY=

# Maksimal pendaftaran UMKM yang berhasil per IP per jam.
REGISTER_LIMIT_PER_HOUR=5
